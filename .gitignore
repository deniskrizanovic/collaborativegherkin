# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Production build
dist/

# Environment files — never commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Database — SQLite dev/CI files (repo-root dev.db, ci.db) and any other db
# files, including a stale prisma/dev.db from before the Drizzle switch
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
dev.db
ci.db

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Playwright test artifacts
test-results/
playwright-report/
e2e/.auth/

# OpenSpec skills and commands
.claude/skills/openspec-*/
.claude/commands/opsx/

# Robot Framework output and uv virtualenv
robot/results/
playwright-log.txt
.venv/
__pycache__/

# Coverage output (lint:crap writes coverage/crap/)
coverage/

# Stryker mutation run (test:mutation writes reports/mutation/ and .stryker-tmp/)
reports/
.stryker-tmp/

# Per-user Claude Code settings
.claude/settings.local.json
.claude/*.doctor-bak
