{
  "name": "collaborativegherkin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "oxlint --max-warnings=0",
    "lint:specs": "node scripts/lint-spec-traceability.mjs",
    "lint:given": "node scripts/lint-spec-given-clause.mjs",
    "lint:issue-link": "node scripts/lint-issue-link.mjs",
    "lint:schema-parity": "node scripts/lint-schema-parity.mjs",
    "lint:dependabot": "node scripts/lint-dependabot.mjs",
    "lint:robot": "node scripts/lint-robot-no-sleep.mjs",
    "lint:robot-steps": "node scripts/lint-robot-spec-steps.mjs",
    "lint:e2e-parity": "node scripts/lint-e2e-parity.mjs",
    "lint:crap": "node scripts/lint-crap.mjs",
    "lint:format": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:robot:init": "uv sync --locked && uv run rfbrowser init chromium",
    "test:robot": "node scripts/run-robot.mjs",
    "e2e:all": "run-s test:robot",
    "test:all": "run-s typecheck && run-p lint lint:specs lint:given lint:issue-link lint:schema-parity lint:dependabot lint:robot lint:robot-steps lint:e2e-parity lint:crap lint:format \"test -- --run\" e2e:all",
    "seed": "tsx scripts/seed.ts",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.sqlite.config.ts",
    "db:migrate:prod": "drizzle-kit migrate --config drizzle.pg.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.sqlite.config.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
      "oxlint --max-warnings=0",
      "bash -c 'tsc --noEmit'"
    ],
    "*.{js,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/drizzle-adapter": "1.11.3",
    "@fontsource/public-sans": "^5.3.0",
    "@next/env": "^16.4.6",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-collaboration": "^3.33.1",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "lib0": "^0.2.120",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nsw-design-system": "^3.28.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.23.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@biomejs/biome": "2.6.7",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-istanbul": "5.1.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
