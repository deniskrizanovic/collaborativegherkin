{
  "name": "collaborativegherkin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "lint:specs": "node scripts/lint-spec-traceability.mjs",
    "lint:given": "node scripts/lint-spec-given-clause.mjs",
    "lint:issue-link": "node scripts/lint-issue-link.mjs",
    "lint:schema-parity": "node scripts/lint-schema-parity.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:all": "run-p lint lint:specs lint:given lint:issue-link lint:schema-parity typecheck \"test -- --run\" test:e2e",
    "seed": "npx tsx prisma/seed.ts",
    "db:generate:postgres": "prisma generate --config prisma/postgres/prisma.config.ts",
    "db:migrate:dev:postgres": "prisma migrate dev --config prisma/postgres/prisma.config.ts && prisma generate --config prisma/postgres/prisma.config.ts",
    "db:migrate:prod": "prisma migrate deploy --config prisma/postgres/prisma.config.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "bash -c 'tsc --noEmit'"
    ]
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource/public-sans": "^5.3.0",
    "@next/env": "^16.3.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-collaboration": "^3.29.2",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "dotenv": "^17.4.2",
    "lib0": "^0.2.117",
    "next": "^16.3.0",
    "next-auth": "5.0.0-beta.31",
    "nsw-design-system": "^3.25.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "prisma": "^7.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
