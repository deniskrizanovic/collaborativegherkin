#!/usr/bin/env sh
pnpm exec lint-staged

# Spec traceability runs against the whole spec tree (not just staged files),
# so it catches drift anywhere in openspec/. Pure filesystem check — no network.
pnpm run lint:specs

# GIVEN-clause gate — every scenario must declare a GIVEN precondition.
# Also whole-tree and offline-safe; sibling of lint:specs.
pnpm run lint:given

# Cross-engine schema parity — the SQLite and Postgres Prisma schemas must
# define the same models/fields. Pure filesystem check, no network; sibling
# of lint:specs.
pnpm run lint:schema-parity

# Robot no-sleep gate — no `Sleep` keyword calls in robot/suites/** or
# robot/resources/**. Pure filesystem check, no network; sibling of lint:specs.
pnpm run lint:robot

# Robot spec-step gate — business-language (`bdd`) Robot tests must repeat
# their spec scenario's GIVEN/WHEN/THEN lines. Whole-tree, pure filesystem,
# no network; sibling of lint:specs.
pnpm run lint:robot-steps

# E2e parity gate — every Playwright test in e2e/ must have a robot/PARITY.md
# row and a Robot test with exactly its title. Whole-tree, offline (reads
# `playwright test --list`, no server or browser); sibling of lint:robot-steps.
pnpm run lint:e2e-parity

# Dependabot config gate — .github/dependabot.yml must parse, assign the owner,
# and only ignore dependencies documented in ADR 0004. Pure filesystem check,
# no network; sibling of lint:specs.
pnpm run lint:dependabot
