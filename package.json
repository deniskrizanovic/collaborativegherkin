{
  "name": "collaborativegherkin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "lint:specs": "node scripts/lint-spec-traceability.mjs",
    "lint:given": "node scripts/lint-spec-given-clause.mjs",
    "lint:issue-link": "node scripts/lint-issue-link.mjs",
    "lint:schema-parity": "node scripts/lint-schema-parity.mjs",
    "lint:dependabot": "node scripts/lint-dependabot.mjs",
    "lint:robot": "node scripts/lint-robot-no-sleep.mjs",
    "lint:robot-steps": "node scripts/lint-robot-spec-steps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:robot:init": "uv sync --locked && uv run rfbrowser init chromium",
    "test:robot": "node scripts/run-robot.mjs",
    "e2e:all": "run-s test:e2e test:robot",
    "test:all": "run-s typecheck && run-p lint lint:specs lint:given lint:issue-link lint:schema-parity lint:dependabot lint:robot lint:robot-steps \"test -- --run\" e2e:all",
    "seed": "tsx prisma/seed.ts",
    "db:generate:postgres": "prisma generate --config prisma/postgres/prisma.config.ts",
    "db:migrate:dev:postgres": "prisma migrate dev --config prisma/postgres/prisma.config.ts && prisma generate --config prisma/postgres/prisma.config.ts",
    "db:migrate:prod": "prisma migrate deploy --config prisma/postgres/prisma.config.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "bash -c 'tsc --noEmit'"
    ]
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "2.11.3",
    "@fontsource/public-sans": "^5.3.0",
    "@next/env": "^16.4.3",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dotenv": "^18.0.9",
    "lib0": "^0.2.119",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "nsw-design-system": "^3.28.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
