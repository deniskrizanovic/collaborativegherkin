# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# --- Local development (SQLite) ---
# Prisma schema: prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# --- Production (PostgreSQL) ---
# Prisma schema: prisma/postgres/schema.prisma — kept at model/field parity with
# the SQLite schema above by the lint:schema-parity gate (edit both together).
# Run migrations with: npm run db:migrate:prod
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# NextAuth secret — generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-string"

# OAuth provider (optional — only needed if using Google/GitHub login)
# GITHUB_ID=""
# GITHUB_SECRET=""

# OpenRouter API key — required for the "Review with AI" feature
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=""

# Resend — required for magic link emails
# Get a free key at https://resend.com
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="noreply@yourdomain.com"

# Dev/test auth bypass — DEV-ONLY. Set in .env.local only; MUST NOT be set in
# production. The test-bypass provider is gated on NODE_ENV !== "production" and
# is dead-code-eliminated from production builds, so setting this in production
# has no effect (ENG-003/004). It enables the local one-click "dev login" button.
# TEST_AUTH_SECRET=""
# TEST_AUTH_EMAIL="e2e-test@example.com"
