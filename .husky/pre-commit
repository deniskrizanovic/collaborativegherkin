#!/usr/bin/env sh
pnpm exec lint-staged

# Spec traceability runs against the whole spec tree (not just staged files),
# so it catches drift anywhere in openspec/. Pure filesystem check — no network.
pnpm run lint:specs

# GIVEN-clause gate — every scenario must declare a GIVEN precondition.
# Also whole-tree and offline-safe; sibling of lint:specs.
pnpm run lint:given

# Cross-engine schema parity — the SQLite and Postgres Prisma schemas must
# define the same models/fields. Pure filesystem check, no network; sibling
# of lint:specs.
pnpm run lint:schema-parity
